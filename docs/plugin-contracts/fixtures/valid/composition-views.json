{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "acme.viewer",
  "name": "Viewer",
  "version": "1.0.0",
  "publisher": "acme",
  "permissions": {
    "system": ["ui"]
  },
  "marketplace": {
    "description": "Compose a left surface, a detail region it fills, and a receiver window.",
    "license": "MIT"
  },
  "contributes": {
    "views": [
      {
        "id": "left",
        "kind": "custom",
        "location": "left",
        "title": "Viewer",
        "entry": "frontend/left/index.html",
        "detailView": "detail"
      },
      {
        "id": "detail",
        "kind": "custom",
        "location": "detail",
        "title": "Viewer Detail",
        "entry": "frontend/detail/index.html",
        "targetSchema": "schemas/target.json"
      },
      {
        "id": "window",
        "kind": "custom",
        "location": "window",
        "title": "Viewer Window",
        "entry": "frontend/window/index.html",
        "receives": {
          "protocolVersion": 1,
          "locations": ["left", "detail"],
          "editorTargets": { "protocolVersion": 1 },
          "closeGuard": { "protocolVersion": 1 }
        }
      }
    ]
  }
}

{
  "schemaVersion": 2,
  "apiVersion": "^1.0.0",
  "id": "acme.viewer",
  "name": "Viewer",
  "version": "1.0.0",
  "publisher": "acme",
  "permissions": {},
  "marketplace": {
    "description": "Bind a detail view to a surface from a window view.",
    "license": "MIT"
  },
  "contributes": {
    "views": [
      {
        "id": "window",
        "kind": "custom",
        "location": "window",
        "title": "Viewer Window",
        "entry": "frontend/window/index.html",
        "detailView": "detail"
      },
      {
        "id": "detail",
        "kind": "custom",
        "location": "detail",
        "title": "Viewer Detail",
        "entry": "frontend/detail/index.html"
      }
    ]
  }
}
